# Supabase Authentication Secrets (Stage 0)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key_here

# Local JWT Secret for offline testing
JWT_SECRET=super-secret-auth-key-for-local-jwt-verification-12345

# Database Connection URL
# PostgreSQL (Docker):
DATABASE_URL=postgresql://postgres:postgres@db:5432/tasks_db

# Local development fallback (SQLite):
# DATABASE_URL=sqlite:///tasks.db

# Optional Redis Cache / Queue Connection
REDIS_URL=redis://redis:6379/0
